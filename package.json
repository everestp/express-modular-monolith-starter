{
  "name": "express-modular-monolith-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:create": "tsx scripts/migrate.ts create",
    "seed": "tsx scripts/seed.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "docker:up": "docker compose -f deploy/docker-compose.yml up -d postgres"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.0",
    "jose": "^5.5.1",
    "pg": "^8.16.0",
    "pino": "^9.1.0",
    "pino-http": "^10.0.0",
    "uuid": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
